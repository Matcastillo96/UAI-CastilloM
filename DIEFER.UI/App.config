<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<connectionStrings>
		<!-- Configurar connection string según entorno. No commitear nombres de máquina reales. -->
		<add name="DIEFER"
		     connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=DIEFER;Integrated Security=True;Connect Timeout=10;MultipleActiveResultSets=True"
		     providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Clave AES-256 (32 bytes en Base64). Configurar via variable de entorno o secrets manager. -->
		<add key="ClaveAES" value="REEMPLAZAR_CON_CLAVE_REAL_EN_DEPLOY" />
	</appSettings>
</configuration>
